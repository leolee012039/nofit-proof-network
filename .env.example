# NoFit Proof Network — environment template.
# Copy to .env.local and fill values locally. NEVER commit real secrets.
# Everything works without any secret: the app falls back to an embedded
# Postgres (PGlite), an offline deterministic AI evaluator and a clearly
# labelled FIXTURE payment provider that is never presented as PayPal.

NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Session signing secret (required when NODE_ENV=production). 32+ random chars.
SESSION_SECRET=

# Database. Leave DATABASE_URL empty to use the embedded PGlite database
# (auto-migrated and auto-seeded with fictional data on first boot). Its default
# folder is ~/.nofit-proof-network/pglite-<hash>: keep it OUTSIDE the project,
# because the Next.js dev server reloads on any file change inside the project.
# Set to a real Postgres URL to use Postgres (run `npm run db:migrate && npm run db:seed`).
DATABASE_URL=
PGLITE_DATA_DIR=

# PayPal — SANDBOX ONLY. Any other PAYPAL_ENV value disables all payments (fail closed).
PAYPAL_ENV=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# From developer.paypal.com > Apps & Credentials (Sandbox). Secret is server-only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID shown after subscribing your public URL /api/paypal/webhook in the dashboard.
PAYPAL_WEBHOOK_ID=
# Optional: sandbox merchant (payee) account ID; when set, captures must be paid to it.
PAYPAL_MERCHANT_ID=
# When PayPal credentials are absent, a labelled FIXTURE checkout (simulated, not
# PayPal) lets the flow be explored offline. Default: on for localhost only.
# Any other deployment must set FIXTURE_PAYMENTS=enabled explicitly.
FIXTURE_PAYMENTS=

# AI provider: "offline-fixture" (deterministic, no network) or "anthropic" (live).
AI_PROVIDER=offline-fixture
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Cap on live model calls (intake drafts + assessment explanations). Over the cap,
# the app uses the labelled offline evaluator. Also set a spend limit in the
# Anthropic Console for any public deployment.
AI_LIVE_CALLS_PER_HOUR=60
AI_LIVE_CALLS_PER_DAY=400

# Global demo reset (wipes ALL demo tenants). Default: on for localhost only.
# Hosted demos must opt in with DEMO_RESET=enabled; "disabled" turns it off.
DEMO_RESET=
